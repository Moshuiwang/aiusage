{
  "schema_version": 1,
  "timezone": "Asia/Shanghai",
  "sqlite": "data/usage.sqlite",
  "latest": "data/latest.json",
  "providers": [
    {
      "provider": "codex",
      "source_id": "codex-main",
      "enabled": true,
      "auth_file": "/path/to/codex/auth.json",
      "rpc": true,
      "rpc_sock": "/path/to/codex-app-server.sock"
    },
    {
      "provider": "claude",
      "source_id": "claude-main",
      "enabled": true,
      "auth_file": "/path/to/claude/auth.json",
      "usage_url": "https://example.invalid/claude/usage",
      "cli": true
    },
    {
      "provider": "claude",
      "source_id": "claude-work",
      "enabled": true,
      "cli": true,
      "env": {
        "CLAUDE_CONFIG_DIR": "/path/to/alternate/claude-config"
      }
    }
  ]
}
